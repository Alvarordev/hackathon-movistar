# Postgres
POSTGRES_USER=nbo
POSTGRES_PASSWORD=nbo
POSTGRES_DB=nbo
POSTGRES_PORT=5433

# Web
WEB_PORT=3000

# Capa de IA — intercambiable sin tocar lógica de aplicación.
# AI_PROVIDER: google | anthropic | openai
AI_PROVIDER=google
AI_MODEL=gemini-2.0-flash

# Solo se necesita la del proveedor elegido. NUNCA llega al navegador.
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
