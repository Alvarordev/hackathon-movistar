# Variables para docker-compose.prod.yml.
#
# En el VPS NO se usa este archivo: estas variables se cargan en la interfaz de
# Dokploy, que es donde vive la API key. Este ejemplo existe para documentarlas
# y para poder probar el stack de producción en local.

# Imágenes en GHCR.
IMAGE_WEB=ghcr.io/alvarordev/copiloto-nbo-web
IMAGE_DB=ghcr.io/alvarordev/copiloto-nbo-db
IMAGE_TAG=latest

# Postgres. La contraseña es obligatoria: el compose falla si no está.
POSTGRES_USER=nbo
POSTGRES_DB=nbo
POSTGRES_PASSWORD=

# El servicio web no publica puerto al host: Traefik lo alcanza por la red
# interna `dokploy-network`. En Dokploy, el dominio se configura contra el
# servicio `web` y el puerto 3000.

# Capa de IA. Sin la key, la app funciona entera salvo el copiloto, que
# devuelve 503 con un mensaje claro.
AI_PROVIDER=google
AI_MODEL=gemini-2.0-flash
GOOGLE_GENERATIVE_AI_API_KEY=
